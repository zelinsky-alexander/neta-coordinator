# NETA Coordinator deployment configuration
NETA_FLEET_ID=fleet-dev
NETA_DB_NAME=neta_coordinator
NETA_DB_USER=neta
NETA_DB_PASSWORD=replace-with-a-long-random-password
NETA_BOOTSTRAP_ENROLLMENT_TOKEN=replace-with-a-long-random-token

# First smoke deployment: localhost HTTP only.
# Change only when TLS/mTLS deployment is configured.
NETA_REQUIRE_CLIENT_CERTIFICATE=false
NETA_BIND_ADDRESS=127.0.0.1
NETA_HOST_PORT=8080

# Conservative JVM sizing for small Linux hosts.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0 -XX:+UseG1GC
