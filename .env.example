# NETA Coordinator deployment configuration
NETA_FLEET_ID=fleet-dev
NETA_DB_NAME=neta_coordinator
NETA_DB_USER=neta
NETA_DB_PASSWORD=replace-with-a-long-random-password
NETA_BOOTSTRAP_ENROLLMENT_TOKEN=replace-with-a-long-random-token

# Separate secret required for state-changing operator actions such as
# agent revoke/reactivate. Read-only operator views do not require it.
NETA_OPERATOR_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# First smoke deployment: localhost HTTP only.
# Change only when TLS/mTLS deployment is configured.
NETA_REQUIRE_CLIENT_CERTIFICATE=false
NETA_BIND_ADDRESS=127.0.0.1
NETA_HOST_PORT=8080

# Agent liveness. Defaults assume a 5-minute heartbeat cadence:
# ONLINE through 7 minutes, STALE through 15 minutes, OFFLINE after 15 minutes.
NETA_AGENT_ONLINE_THRESHOLD=PT7M
NETA_AGENT_OFFLINE_THRESHOLD=PT15M

# Incident v0 materialization. Grouping itself uses a conservative one-hour gap;
# this controls how often new ungrouped findings are synchronized in background.
NETA_INCIDENT_SYNC_INTERVAL=PT1M

# MS4.1 bounded coordinator storage.
# Heartbeats update agents.last_seen_at/last_sequence/current payload without
# creating permanent protocol/audit rows unless explicitly enabled.
NETA_RETAIN_HEARTBEATS=false
NETA_AUDIT_HEARTBEATS=false
NETA_PROTOCOL_RETENTION=P7D
NETA_ACCEPTED_AUDIT_RETENTION=P30D
NETA_STORAGE_CLEANUP_INTERVAL=PT1H

# Conservative JVM sizing for small Linux hosts.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0 -XX:+UseG1GC
