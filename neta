#!/usr/bin/env bash
set -euo pipefail

base_url="${NETA_COORDINATOR_URL:-http://127.0.0.1:${NETA_HOST_PORT:-8080}}"
curl_args=(-fsS --connect-timeout 2 --max-time 10)

if [[ -n "${NETA_OPERATOR_CA:-}" ]]; then
  curl_args+=(--cacert "$NETA_OPERATOR_CA")
fi
if [[ -n "${NETA_OPERATOR_CERT:-}" ]]; then
  curl_args+=(--cert "$NETA_OPERATOR_CERT")
fi
if [[ -n "${NETA_OPERATOR_KEY:-}" ]]; then
  curl_args+=(--key "$NETA_OPERATOR_KEY")
fi

usage() {
  cat <<'EOF'
Usage:
  ./neta endpoints
  ./neta findings [limit]

Environment:
  NETA_COORDINATOR_URL  Coordinator base URL (default http://127.0.0.1:8080)
  NETA_OPERATOR_CA      Optional CA certificate for HTTPS
  NETA_OPERATOR_CERT    Optional client certificate for mTLS
  NETA_OPERATOR_KEY     Optional client key for mTLS
EOF
}

command="${1:-help}"
case "$command" in
  endpoints)
    exec curl "${curl_args[@]}" "$base_url/api/v1/operator/endpoints"
    ;;
  findings)
    limit="${2:-10}"
    if ! [[ "$limit" =~ ^[0-9]+$ ]] || (( limit < 1 || limit > 100 )); then
      echo "finding limit must be an integer from 1 to 100" >&2
      exit 2
    fi
    exec curl "${curl_args[@]}" "$base_url/api/v1/operator/findings?limit=$limit"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
